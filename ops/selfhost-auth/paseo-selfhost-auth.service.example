# systemd unit for the self-host auth wall.
#
# Install:
#   sudo install -d -m 755 /opt/paseo-selfhost-auth
#   sudo install -m 644 ops/selfhost-auth/auth-server.mjs /opt/paseo-selfhost-auth/
#   sudo cp ops/selfhost-auth/paseo-selfhost-auth.service.example \
#     /etc/systemd/system/paseo-selfhost-auth.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paseo-selfhost-auth
#
# The runtime copy lives in /opt (not the /root git checkout) because the
# hardening below sets ProtectHome=true, which hides /root from the service.
# Secrets are read from an EnvironmentFile (chmod 600) so they never appear in
# `systemctl show` output or the process command line. See docs/selfhost-auth.md.

[Unit]
Description=Paseo self-host web auth wall (app.haikostudio.cloud)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/paseo-selfhost-auth/auth-server.mjs
EnvironmentFile=/etc/paseo-selfhost-auth.env
Restart=on-failure
RestartSec=2
# Hardening: the service needs nothing but the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
