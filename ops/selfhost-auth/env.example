# Copy to /etc/paseo-selfhost-auth.env (chmod 600, owned by root) and fill in.
# This file holds all auth secrets. It is read by the systemd unit and never
# shipped to the browser. See docs/selfhost-auth.md.

# The login username (pseudo).
PASEO_AUTH_USER=admin

# scrypt hash of the password. Generate with:
#   node ops/selfhost-auth/hash-password.mjs 'your-password'
PASEO_AUTH_PASSWORD_HASH=scrypt$REPLACE_ME$REPLACE_ME

# Random secret used to sign session cookies (>= 16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates all existing sessions (forces re-login).
PASEO_AUTH_SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# --- Optional tuning (defaults shown) ---
# PASEO_AUTH_PORT=17790
# PASEO_AUTH_HOST=127.0.0.1
# PASEO_AUTH_COOKIE_NAME=paseo_session
# PASEO_AUTH_LOGIN_PATH=/auth/login
# PASEO_AUTH_SESSION_TTL_DAYS=30
# PASEO_AUTH_MAX_ATTEMPTS=5
# PASEO_AUTH_LOCKOUT_MINUTES=15
